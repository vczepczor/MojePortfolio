---
// Písma: jen řezy, které web opravdu používá (prohlížeč stáhne jen latinku + latin-ext).
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { homePath, useTranslations, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** URL této stránky v obou jazycích (přepínač jazyka + hreflang). */
  alternates?: Record<Lang, string>;
  /** Open Graph typ: hlavní stránka = website, projekt = article. */
  ogType?: 'website' | 'article';
  /** Stránky jako 404 nechceme ve vyhledávačích ani s hreflang. */
  noindex?: boolean;
}

const { lang, title, description, alternates, ogType = 'website', noindex = false } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} – ${SITE.name}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const alts = alternates ?? { cs: homePath('cs'), en: homePath('en') };

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (path: string) => new URL(path, Astro.site).href;
const ogImage = abs(withBase('/og.png'));
const ogLocale = { cs: 'cs_CZ', en: 'en_US' } as const;
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE.name} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0f0f" />
    {noindex && <meta name="robots" content="noindex" />}

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="cs" href={abs(alts.cs)} />
          <link rel="alternate" hreflang="en" href={abs(alts.en)} />
          <link rel="alternate" hreflang="x-default" href={abs(alts.cs)} />
        </>
      )
    }

    <!-- Open Graph / sdílení -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <Header lang={lang} alternates={alts} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
