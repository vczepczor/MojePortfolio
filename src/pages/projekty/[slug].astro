---
import ProjectPage from '../../components/project/ProjectPage.astro';
import { getProjects, projectSlug } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('cs');
  return projects.map((entry, i) => ({
    params: { slug: projectSlug(entry) },
    props: { entry, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
---

<ProjectPage lang="cs" entry={entry} prev={prev} next={next} />
